rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔹 Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isRestaurantOwner(restaurantId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
         get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId == restaurantId)
      );
    }

    // 👤 USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 🍽️ RESTAURANTS
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isRestaurantOwner(restaurantId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 🔒 SLUG CONSTRAINTS
    match /slugConstraints/{slugId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // 📋 MENUS
    match /menus/{menuId} {
      allow read: if true;

      allow create: if isSuperAdmin() ||
        isRestaurantOwner(request.resource.data.restaurantId);

      allow update: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId);

      allow delete: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId);
    }

    // 💳 SUBSCRIPTIONS
    match /subscriptions/{subId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isSuperAdmin();
    }

    // 📦 PLANS
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 📢 UPDATES
    match /updates/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 🪑 TABLES
    match /tables/{tableId} {
      allow read: if true;

      allow create: if isSuperAdmin() ||
        isRestaurantOwner(request.resource.data.restaurantId);

      // We allow customers to tentatively update tables if needed for status updates.
      allow update: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'paymentStatus']));

      allow delete: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId);
    }

    // 🧾 ORDERS
    match /orders/{orderId} {
      // ✅ Allow customers to create orders
      allow create: if true;

      // ✅ Anyone can read (QR flow)
      allow read: if true;

      // Owner/admin OR authenticated user
      allow update: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId) ||
        isAuthenticated();

      allow delete: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId);
    }

    // 📅 RESERVATIONS
    match /reservations/{reservationId} {
      // ✅ Allow customers to book
      allow create: if true;

      allow read: if true;

      allow update: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId) ||
        isAuthenticated();

      allow delete: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId);
    }

    // ⏳ WAITLIST
    match /waitlist/{waitlistId} {
      // ✅ Allow customers to join waitlist
      allow create: if true;

      allow read: if true;

      allow update: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId) ||
        isAuthenticated();

      allow delete: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId);
    }

    // 🛎️ WAITER CALLS
    match /waiterCalls/{callId} {
      // ✅ Allow customers using the menu to call waiter
      allow create: if true;
      allow read: if true;
      allow update, delete: if isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId) ||
        isAuthenticated();
    }
  }
}
